{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	// Profile: "bug-finding max", shared with norviq-web-v2. Every rule in the
	// correctness, suspicious and perf categories, plus the type-aware rules
	// from pedantic that catch real defects. pedantic/style/restriction as
	// whole categories stay off: they are mostly taste (no-ternary,
	// no-magic-numbers, sort-keys) or mutually exclusive (no-named-export vs
	// SvelteKit's required named exports).
	// Svelte template rules still run in ESLint (eslint.config.js).
	"plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest", "node"],
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "error"
	},
	"env": { "browser": true, "node": true, "es2024": true },
	"ignorePatterns": [
		".svelte-kit/**",
		"build/**",
		".wrangler/**",
		// Vendored, minified third-party bundles.
		"static/**",
		"storybook-static/**",
		"src/lib/paraglide/**"
	],
	"overrides": [
		// `export {}` is what makes an ambient declaration file a module.
		{ "files": ["**/*.d.ts"], "rules": { "unicorn/require-module-specifiers": "off" } },
		// The `#lib` alias target (package.json "imports"): a placeholder with
		// nothing to export yet.
		{ "files": ["src/lib/index.ts"], "rules": { "unicorn/no-empty-file": "off" } },
		// Command-line scripts and the e2e provider stub report on stdout.
		{ "files": ["scripts/**", "tests/e2e/stubs/**"], "rules": { "no-console": "off" } },
		// Plain JavaScript has no types to be unsafe about: everything it reads
		// from a JSON file or a module without declarations is `any`.
		{
			"files": ["**/*.mjs", "**/*.js"],
			"rules": {
				"typescript/no-unsafe-member-access": "off",
				"typescript/no-unsafe-assignment": "off",
				"typescript/no-unsafe-call": "off",
				"typescript/no-unsafe-argument": "off",
				"typescript/no-unsafe-return": "off"
			}
		},
		// A test double is an object asserted to be the real type; that
		// assertion is the technique, not a defect.
		{
			"files": ["**/*.spec.ts", "**/*.test.ts", "tests/**"],
			"rules": { "typescript/no-unsafe-type-assertion": "off" }
		},
		// BACKLOG (e2e only; count as of 2026-11-17). The Playwright suite reads
		// the API's JSON through helpers.ts `api()`, which returns `any`, and
		// asserts on it untyped. Typing it means moving the suite to the
		// generated client, which cannot be checked without the Go API running.
		// Everywhere else these rules are errors.
		{
			"files": ["tests/e2e/**"],
			"rules": {
				"typescript/no-unsafe-member-access": "warn", // 156
				"typescript/no-unsafe-assignment": "warn", // 106
				"typescript/no-unsafe-call": "warn", // 22
				"typescript/no-unsafe-argument": "warn", // 9
				"typescript/no-unsafe-return": "warn" // 8
			}
		}
	],
	"rules": {
		// Type-aware bug rules that oxlint files under pedantic.
		"typescript/only-throw-error": "error",
		"typescript/prefer-promise-reject-errors": "error",
		"typescript/return-await": "error",
		"typescript/no-mixed-enums": "error",
		// Non-type-aware pedantic rules that catch defects rather than style.
		"eqeqeq": ["error", "always", { "null": "ignore" }],
		"array-callback-return": "error",
		"no-self-compare": "error",
		"no-constructor-return": "error",

		"no-unused-vars": [
			"error",
			{ "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }
		],

		// Rules of the profile from outside the three categories that this tree
		// already passes, so they are enforced from day one.
		"typescript/restrict-plus-operands": "error",
		"typescript/unbound-method": "error",
		"typescript/no-unnecessary-type-parameters": "error",
		"vitest/no-conditional-expect": "error",
		"vitest/valid-title": "error",
		"no-fallthrough": "error",
		"no-new": "error",
		"no-useless-concat": "error",
		"promise/no-promise-in-callback": "error",
		"import/no-named-as-default": "error",
		"import/namespace": "error",
		// Retired from the backlog on 2026-11-17: the tree was fixed to pass each.
		"typescript/switch-exhaustiveness-check": "error",
		"typescript/no-floating-promises": "error",
		"typescript/no-misused-promises": "error",
		"typescript/await-thenable": "error",
		"typescript/no-misused-spread": "error",
		"typescript/no-base-to-string": "error",
		"typescript/restrict-template-expressions": "error",
		"typescript/no-unsafe-member-access": "error",
		"typescript/no-unsafe-assignment": "error",
		"typescript/no-unsafe-call": "error",
		"typescript/no-unsafe-argument": "error",
		"typescript/no-unsafe-return": "error",
		"typescript/no-unnecessary-type-assertion": "error",
		"typescript/no-unnecessary-type-conversion": "error",
		"typescript/no-redundant-type-constituents": "error",
		"typescript/no-deprecated": "error",
		"typescript/require-await": "error",
		"typescript/require-array-sort-compare": "error",
		"typescript/triple-slash-reference": "error",
		"no-promise-executor-return": "error",
		"no-underscore-dangle": "error",
		"no-shadow": "error",
		"no-console": ["error", { "allow": ["warn", "error"] }],
		"unicorn/no-empty-file": "error",
		"unicorn/consistent-function-scoping": "error",
		"unicorn/prefer-add-event-listener": "error",
		"vitest/require-mock-type-parameters": "error",
		// `near` in the motion tests wraps expect().toBeCloseTo().
		"vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "near"] }],
		// expect(value, message) is vitest's own API.
		"vitest/valid-expect": ["error", { "maxArgs": 2 }],
		// A stylesheet is imported for its side effect.
		"import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
		// A then() that ends a chain has nobody to return to.
		"promise/always-return": ["error", { "ignoreLastCallback": true }],
		// For text, || is the point: an empty string (a blank env value, an
		// empty message) is as missing as undefined.
		"typescript/prefer-nullish-coalescing": ["error", { "ignorePrimitives": { "string": true } }],

		// Off, each because it is wrong for this tree rather than unfixed.
		// Every hit sorted or reversed an array made on that line (a spread, a
		// filter, Object.keys), so nothing shared is mutated. toSorted() and
		// toReversed() are ES2023, newer than the build target, and nothing
		// here polyfills them.
		"unicorn/no-array-sort": "off",
		"unicorn/no-array-reverse": "off",
		// The hits copied small config and fixture rows on purpose, so the
		// source objects are not mutated; there is no hot path to save.
		"oxc/no-map-spread": "off",
		// All 56 hits were form actions and loads that end in redirect() or
		// error(). Those return never, so the function cannot fall off its
		// end; TypeScript knows that and this rule does not.
		"typescript/consistent-return": "off",
		// Every hit awaited in order on purpose: reading a stream, a typing
		// animation, trying one window after another, writes that stop at the
		// first refusal, ordered test steps. None is a batch.
		"no-await-in-loop": "off",

		// BACKLOG. What the existing code still breaks (count as of 2026-11-17,
		// with --type-aware). It reports as a warning so CI stays green. The
		// 78 are assertions at a boundary this app does not validate: API
		// replies read as their generated type, form text passed on as an API
		// enum for the API to refuse, multipart bodies through openapi-fetch,
		// three.js and DOM narrowing. Retiring it means validating those
		// values, then moving the line to "error". The e2e backlog for the
		// no-unsafe-* rules is in "overrides" above. Never add a rule here.
		"typescript/no-unsafe-type-assertion": "warn" // 78
	}
}
