// Khepri web (SvelteKit) on Cloudflare Workers with static assets.
// Hosting plan, routing and cut-over: docs/architecture/hosting-cloudflare.md.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "khepri-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-28",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	// kheprios.com went to Cloudflare on 2026-10-29. Go-owned paths have their own
	// Worker-less routes (docs/architecture/hosting-cloudflare.md), so they never
	// reach this Worker. www is not routed here: a zone redirect rule sends it to
	// the apex, where the session cookie and the passkey relying party live.
	"routes": [{ "pattern": "kheprios.com/*", "zone_name": "kheprios.com" }],
	// The workers.dev URL stays up for trying a build.
	"workers_dev": true,
	"vars": {
		// north-client's JSON API as the Worker reaches it.
		"NORTH_API_URL": "https://kheprios.com/api/v1",
		// Where requests for Go-owned paths (/api/v1, /mcp, /oauth/token, …) are
		// passed through to. Unset means no passthrough (local dev).
		"GO_ORIGIN": "https://kheprios.com",
		// Same values as the Go deployment (apps/khepri/web in the infra repo).
		"APPLE_TEAM_ID": "84X9WYBF36",
		"APPLE_BUNDLE_ID": "com.fernandocorreia.khepri,com.fernandocorreia.khepri.beta",
		"POSTHOG_HOST": "https://eu.i.posthog.com",
		// POSTHOG_API_KEY is set per environment (it is public, but differs by project).
		// The 3D emblem (login) and mascot (onboarding), ADRs 0005 and 0006.
		// Promoted to production 2026-11-13; empty turns either off.
		"EMBLEM_3D_MODEL_URL": "/assets/models/emblem-47d19e3b.glb",
		"MASCOT_3D_MODEL_URL": "/assets/models/mascot-03301e1f.glb"
	},
	"env": {
		// The beta channel (ADR 0005): the same build as production on its own
		// workers.dev URL, no custom domain. It exists to try experiments on a
		// device before production sees them; today the 3D emblem and mascot.
		// Vars are not inherited from the top level, so they are repeated here.
		// No POSTHOG_API_KEY: beta reports nothing.
		"beta": {
			"name": "khepri-web-beta",
			"routes": [],
			"workers_dev": true,
			"vars": {
				"NORTH_API_URL": "https://kheprios.com/api/v1",
				"GO_ORIGIN": "https://kheprios.com",
				"APPLE_TEAM_ID": "84X9WYBF36",
				"APPLE_BUNDLE_ID": "com.fernandocorreia.khepri,com.fernandocorreia.khepri.beta",
				"POSTHOG_HOST": "https://eu.i.posthog.com",
				// static/assets/models/README.md says how to cut a new one.
				"EMBLEM_3D_MODEL_URL": "/assets/models/emblem-47d19e3b.glb",
				// The 3D mascot on /app/onboarding (ADR 0006).
				"MASCOT_3D_MODEL_URL": "/assets/models/mascot-03301e1f.glb"
			}
		}
	}
}
